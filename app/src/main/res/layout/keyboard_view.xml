<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/keyboardRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/keyboard_background"
    android:paddingTop="2dp"
    android:paddingBottom="2dp"
    android:paddingStart="4dp"
    android:paddingEnd="4dp">

    <!-- Debug Context Bar (Visible only when debug_display option is ON) -->
    <LinearLayout
        android:id="@+id/contextBarContainer"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:layout_marginBottom="2dp"
        android:visibility="gone">

        <!-- Context Badge -->
        <TextView
            android:id="@+id/tvContextBadge"
            android:layout_width="wrap_content"
            android:layout_height="16dp"
            android:gravity="center"
            android:text="CTX: 0字"
            android:textSize="9.5sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:background="@drawable/badge_background"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            android:layout_marginEnd="6dp" />

        <!-- SLM Rerank Debug Status Badge -->
        <TextView
            android:id="@+id/tvDebugSlmBadge"
            android:layout_width="wrap_content"
            android:layout_height="16dp"
            android:gravity="center"
            android:text="SLM"
            android:textSize="9.5sp"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:background="@drawable/badge_background"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            android:layout_marginEnd="6dp"
            android:visibility="gone" />

        <!-- Accessible Context Text Stream -->
        <TextView
            android:id="@+id/tvContextContent"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical|start"
            android:singleLine="true"
            android:ellipsize="start"
            android:text="(空)"
            android:textColor="@color/text_secondary"
            android:textSize="10.5sp"
            android:fontFamily="monospace" />
    </LinearLayout>

    <!-- Top Candidate & Voice Header Bar -->
    <LinearLayout
        android:id="@+id/keyboardHeader"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:layout_marginBottom="2dp">

        <!-- Persistent Voice Toggle Button -->
        <FrameLayout
            android:id="@+id/voiceToggleContainer"
            android:layout_width="66dp"
            android:layout_height="30dp"
            android:layout_marginEnd="6dp">

            <Button
                android:id="@+id/btnVoiceToggle"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="🎙 話す"
                android:textColor="@color/voice_toggle_idle_text"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="@drawable/bg_voice_toggle_idle"
                android:padding="0dp"
                style="?android:attr/borderlessButtonStyle" />

            <ProgressBar
                android:id="@+id/progressDecoding"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:indeterminateTint="@color/primary"
                android:visibility="gone" />
        </FrameLayout>

        <!-- Candidate Strip View -->
        <com.example.myasr.context.ime.presentation.CandidateStripView
            android:id="@+id/candidateStripView"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <View
            android:id="@+id/recordingIndicator"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_recording_pulse"
            android:visibility="gone" />

        <!-- Compact Header Shortcut: User Dictionary -->
        <Button
            android:id="@+id/btnHeaderDict"
            android:layout_width="32dp"
            android:layout_height="28dp"
            android:layout_marginStart="2dp"
            android:text="📖"
            android:textSize="13sp"
            android:padding="0dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            style="?android:attr/borderlessButtonStyle" />

        <!-- Compact Header Shortcut: Clipboard History Access (Icon Only) -->
        <Button
            android:id="@+id/btnHeaderClipboard"
            android:layout_width="32dp"
            android:layout_height="28dp"
            android:layout_marginStart="2dp"
            android:text="📋"
            android:textSize="13sp"
            android:padding="0dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            style="?android:attr/borderlessButtonStyle" />
    </LinearLayout>

    <!-- Keyboard Body Surface (Flick & QWERTY Keyboard with ClipboardHistoryView Overlay) -->
    <FrameLayout
        android:id="@+id/keyboardBodyContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.example.myasr.context.ime.presentation.FlickKeyboardView
            android:id="@+id/flickKeyboardView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.example.myasr.context.clipboard.presentation.ClipboardHistoryView
            android:id="@+id/clipboardHistoryView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>

</LinearLayout>
