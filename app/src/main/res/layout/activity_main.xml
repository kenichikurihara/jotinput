<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/coordinatorRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top App Bar -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/mainToolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface"
            app:subtitle="オンデバイス音声・AIかな漢字入力"
            app:subtitleTextColor="@color/text_secondary"
            app:title="JotInput"
            app:titleTextColor="@color/text_primary" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border" />

        <!-- Cross-Tab Global Background Provisioning Banner -->
        <LinearLayout
            android:id="@+id/layoutGlobalProvisioningBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/badge_info_bg"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvGlobalProvisioningStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="バックグラウンドで準備中..."
                android:textColor="@color/badge_info_text"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/globalProvisioningProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:indeterminate="false"
                android:max="100"
                android:progress="0" />
        </LinearLayout>

        <!-- 3-Tab Content Container -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <include layout="@layout/tab_main_home" />

            <include layout="@layout/tab_main_settings" />

            <include layout="@layout/tab_main_data" />
        </FrameLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border" />

        <!-- Bottom Navigation Bar -->
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface"
            app:itemIconTint="@color/primary"
            app:itemTextColor="@color/text_primary"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/menu_main_bottom_nav" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
